# =====================================================================================================
# thinktool.com.tr — Alastyr (cPanel · LiteSpeed / Apache 2.4) .htaccess
# OTOMATİK ÜRETİLDİ — elle düzenlemeyin (scripts/package.mjs). Kanonik köken: https://thinktool.com.tr
# PHP sürümü satırı (cPanel MultiPHP) sunucudaki yayın betiği tarafından korunur.
# =====================================================================================================

Options -Indexes
DirectoryIndex index.html index.php
# Her sayfanın yanında aynı adlı bir klasör (Next.js veri dosyaları) var: /urunler → /urunler/ yönlendirmesi olmasın
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
</IfModule>

RewriteEngine On
RewriteBase /

# ── 1) SSL doğrulaması (AutoSSL): hiçbir kurala takılmaz ──
RewriteRule ^\.well-known/ - [L]

# ── 2) Kanonik adres: www → çıplak alan adı, http → https (yalnız canlı alan adında) ──
RewriteCond %{HTTP_HOST} ^www\.thinktool\.com\.tr$ [NC]
RewriteRule ^ https://thinktool.com.tr%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^thinktool\.com\.tr$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://thinktool.com.tr%{REQUEST_URI} [R=301,L,NE]
# Test/önizleme alan adları arama motorlarına kapalı
RewriteCond %{HTTP_HOST} !^(?:www\.)?thinktool\.com\.tr$ [NC]
RewriteRule ^ - [E=TT_NOINDEX:1]

# ── 3) Gizli ve sunucu dosyaları ──
RewriteRule (?:^|/)\. - [F]
RewriteRule ^(?:_app|yonetim/_inc)(?:/|$) - [F]
RewriteRule (?:^|/)(?:error_log|php\.ini|composer\.(?:json|lock))$ - [F,NC]
RewriteRule \.(?:sqlite|sql|db|zip|tar|tgz|gz|7z|rar|bak|old|orig|log|sh|swp|ini|env|md)$ - [F,NC]

# ── 4) Eski WordPress/WooCommerce adresleri ──
# PayTR bildirim adresi (PayTR panelindeki kayıt değişmeden çalışır): /index.php?wc-api=wc_gateway_paytrcheckout
RewriteCond %{QUERY_STRING} (?:^|&)wc-api=wc_gateway_paytrcheckout(?:&|$) [NC]
RewriteRule ^(?:index\.php)?$ api/paytr/callback.php [L]
# (THE_REQUEST: DirectoryIndex'in iç yönlendirmesi döngüye girmesin)
RewriteCond %{THE_REQUEST} \s/+index\.(?:php|html)[\s?]
RewriteRule ^index\.(?:php|html)$ / [R=301,L]
RewriteRule ^(?:wp-login\.php|xmlrpc\.php|wp-json(?:/.*)?|wp-admin(?:/.*)?|wp-includes(?:/.*)?)$ - [G]
# Eski görsel adresleri (Google Görseller): sunucuda kalan wp-content/uploads dosyaları sunulur; wp-content'in geri kalanı yok.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^wp-content/uploads/.+\.(?:jpe?g|png|gif|webp|avif|svg|pdf)$ - [L,NC]
RewriteRule ^wp-content(?:/|$) - [G]
# PHP yalnızca api/ ve yonetim/ altında çalışır; başka yerde kalmış bir betik istenirse 403.
RewriteRule ^(?!api/|yonetim/)(?:.*/)?[^/]+\.(?:php\d?|phtml|phar|cgi|pl|py)$ - [F,NC]
RewriteRule ^thinktool/?$ /urun/thinktool-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-ce-evd/?$ /urun/thinktool-ce-evd-elektrikli-arac-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-expert-394-ai/?$ /urun/thinktool-expert-394-ai-destekli-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-expert-391/?$ /urun/thinktool-expert-391-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-lite/?$ /urun/thinktool-lite-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-lite-2/?$ /urun/thinktool-lite-2-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-reader-7/?$ /urun/thinktool-reader-7-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-max/?$ /urun/thinktool-max-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-master/?$ /urun/thinktool-master-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-master-2/?$ /urun/thinktool-master-2-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-master-2-2/?$ /urun/thinktool-master-2-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-master-x/?$ /urun/thinktool-master-x-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-master-x2/?$ /urun/thinktool-master-x2-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-master-cv/?$ /urun/thinktool-master-cv-ariza-tespit-cihazi [R=301,L,NC]
RewriteRule ^thinktool-hml-box/?$ /urun/thinktool-hml-box [R=301,L,NC]
RewriteRule ^arac-ariza-tespit-sistemi-kullanimi/?$ /blog/arac-ariza-tespit-sistemi-kullanimi [R=301,L,NC]
RewriteRule ^arac-ariza-tespit-sistemlerinin-avantajlari-aracinizi-daha-iyi-taniyin/?$ /blog/arac-ariza-tespit-sistemlerinin-avantajlari-aracinizi-daha-iyi-taniyin [R=301,L,NC]
RewriteRule ^agir-vasita-araclarinda-ariza-tespiti/?$ /blog/agir-vasita-araclarinda-ariza-tespiti [R=301,L,NC]
RewriteRule ^urunlerimiz/?$ /urunler [R=301,L,NC]
RewriteRule ^magaza/?$ /urunler [R=301,L,NC]
RewriteRule ^sepetim/?$ /sepet [R=301,L,NC]
RewriteRule ^odeme-sayfasi/?$ /sepet [R=301,L,NC]
RewriteRule ^hesabim(?:/.*)?$ /siparis-takip [R=301,L,NC]
RewriteRule ^category(?:/.*)?$ /blog [R=301,L,NC]
RewriteRule ^author(?:/.*)?$ /blog [R=301,L,NC]
RewriteRule ^tag(?:/.*)?$ /blog [R=301,L,NC]
RewriteRule ^feed(?:/.*)?$ /blog [R=301,L,NC]
RewriteRule ^urun-kategori(?:/.*)?$ /urunler [R=301,L,NC]

# ── 5) Uygulama adresleri ──
# E-postadaki sipariş bağlantısı: /siparis/4001?k=… → erişim çerezi verilir, sipariş sayfasına geçilir
RewriteRule ^siparis/([0-9]+)/?$ api/order-link.php?no=$1 [QSA,L]
RewriteRule ^yonetim$ /yonetim/ [R=301,L]
# Yüklenen görseller: yalnızca görsel dosyaları
RewriteRule ^uploads/.*\.(?!(?:webp|avif|jpe?g|png|gif|svg)$)[^./]+$ - [F,NC]

# ── 6) Sayfalar: sondaki "/" kaldırılır, uzantısız adres .html dosyasından sunulur ──
RewriteCond %{REQUEST_URI} !^/(?:api|yonetim)/
RewriteRule ^(.+)/$ /$1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+((?!404\.html|index\.html)[^?\s]+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ── 7) Başlıklar ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Robots-Tag "noindex, nofollow" env=TT_NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=REDIRECT_TT_NOINDEX
  <FilesMatch "\.(?:html|txt|xml|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:webp|avif|jpe?g|png|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/json application/javascript text/javascript image/svg+xml application/manifest+json
</IfModule>
